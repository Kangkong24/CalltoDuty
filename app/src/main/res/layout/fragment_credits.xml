<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/dia_container"
    android:padding="0dp"
    android:gravity="top"
    tools:context=".CreditsFragment">

    <!-- Title and Close Button Row -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_marginTop="10dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/optionTitle"
            android:text="@string/credits"
            android:textSize="28sp"
            android:layout_centerHorizontal="true"
            android:fontFamily="@font/poppins_semibold"
            android:textColor="@color/white"
            android:layout_marginBottom="10dp" />

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/closeButton"
            android:src="@drawable/close_btn"
            android:layout_alignParentEnd="true"
            android:contentDescription="@string/close_btn_desc"
            android:layout_marginEnd="10dp" />
    </RelativeLayout>

    <!-- Credits Content -->
    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/credits_content"
        android:src="@drawable/credits_contents"
        android:layout_centerInParent="true"
        android:layout_marginBottom="40dp" />

</RelativeLayout>
