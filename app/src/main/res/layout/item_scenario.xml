<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/scen_container"
    android:padding="16dp">

    <TextView
        android:id="@+id/scenarioNameTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="18sp"
        android:fontFamily="@font/poppins_semibold"
        android:textColor="@android:color/black"
        android:textStyle="bold"/>

    <TextView
        android:id="@+id/scenarioDescriptionTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:textColor="@android:color/darker_gray"/>

    <ImageView
        android:id="@+id/scenarioImageView"
        android:layout_width="40dp"
        android:layout_height="35dp"
        android:layout_gravity="center"
        android:contentDescription="@string/scenario_image_description"
        android:visibility="gone" /> <!-- Initially hidden -->


</LinearLayout>
